# Listener settings. setup.sh installs this as /etc/now-playing/listener.env (root only, mode 600,
# because it holds the API key). All values here are placeholders.

# Address of the Now Playing server on your network.
NPL_SERVER_URL=http://tower.local:8080
# An API key made on the server's Host page ("API keys"). It starts npk_ and is shown once.
NPL_API_KEY=npk_replace-me
# ALSA capture device. A USB sound card is usually not "default": list devices with `arecord -l`
# and use plughw:<card>,<device>, e.g. plughw:1,0. Check the level with `now-playing-listener test-mic`.
NPL_ALSA_DEVICE=default

# Optional (defaults shown).
# Clips quieter than this are never sent.
# NPL_SILENCE_DBFS=-45
# Seconds per clip (5 to 30). The server takes clips up to 2 MB: seconds x sample rate x 2 bytes.
# NPL_CLIP_SECONDS=10
# NPL_SEARCH_INTERVAL=30s
# NPL_TRACK_INTERVAL=3m
# NPL_HEARTBEAT_INTERVAL=30s
# NPL_SAMPLE_RATE=44100
# NPL_LOG_LEVEL=info
